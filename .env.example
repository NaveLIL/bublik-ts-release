# Bublik Bot — copy to .env and replace every required placeholder.

# Discord
DISCORD_TOKEN=your_discord_token_here
DISCORD_CLIENT_ID=your_client_id_here
OWNER_ID=

# Comma-separated guild IDs used only to seed an empty database. Later changes
# are managed through /whitelist and remain persistent.
ALLOWED_GUILDS=
DEV_GUILD_ID=

# PostgreSQL
# Percent-encode @, :, /, # and other reserved characters inside the password.
DATABASE_URL=postgresql://bublik:change_me_to_a_strong_password@postgres:5432/bublik?schema=public
POSTGRES_USER=bublik
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=bublik
BUBLIK_POSTGRES_IMAGE=postgres@sha256:20edbde7749f822887a1a022ad526fde0a47d6b2be9a8364433605cf65099416

# The ordinary bot service always forces this to 0. Pass 1 only as an explicit
# override to the audited migration-only container after backup/restore rehearsal.
PRISMA_BASELINE_EXISTING=0

# Redis — noeviction is required for locks, cooldowns and idempotency keys.
REDIS_URL=redis://redis:6379
REDIS_MAXMEMORY=256mb
BUBLIK_REDIS_IMAGE=redis@sha256:8b81dd37ff027bec4e516d41acfbe9fe2460070dc6d4a4570a2ac5b9d59df065

# Bot image. Production releases should use an immutable sha256 digest.
BUBLIK_IMAGE=bublik-n-bot:latest

# Runtime
NODE_ENV=production
DEFAULT_LOCALE=ru
BOT_COLOR="#5865F2"
LOG_LEVEL=info
ERROR_CHANNEL_ID=
BUBLIK_HEALTH_FILE=/tmp/bublik-health.json
BUBLIK_HEALTH_MAX_AGE_MS=75000

# Battle-rating rotation. Prefer managing production data through bot commands.
BR_ROTATION_DATA=[]
BR_TEMPLATE_GUILD_ID=
BR_ROTATION_NOTIFY_CHANNEL_ID=
BR_ROTATION_NOTIFY_ROLE_ID=
BR_ROTATION_NOTIFY_HOUR=12

# Optional Minecraft / EREZCRAFT integration. It remains disabled until a
# Discord guild, RCON host and RCON password are all configured explicitly.
MINECRAFT_GUILD_ID=
RCON_HOST=
RCON_PORT=25575
RCON_PASSWORD=
RCON_TIMEOUT_MS=5000

# One-time import of legacy onboarding environment settings into one guild.
# Database configuration becomes authoritative after a successful import.
WELCOME_LEGACY_GUILD_ID=
WELCOME_CHANNEL_ID=
TICKET_CHANNEL_ID=
RECRUIT_ROLE_ID=
AUTO_ROLE_ID=

# Optional single-guild customization.
NS_GUILD_ID=
