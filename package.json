{
  "name": "bublik-bot",
  "version": "1.0.0",
  "description": "Protected runtime distribution of the Bublik Discord bot",
  "author": "NaveL",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "main": "dist-protected/index.js",
  "scripts": {
    "start": "node dist-protected/index.js",
    "verify:distribution": "node scripts/verify-distribution.js",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "docker:up": "docker compose -p bublik-n up -d --build",
    "docker:down": "docker compose -p bublik-n down",
    "docker:logs": "docker compose -p bublik-n logs -f bot"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "ioredis": "^5.4.1",
    "prisma": "^5.22.0",
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
